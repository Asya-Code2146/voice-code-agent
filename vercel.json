{
  "framework": "vite",
  "buildCommand": "node -e \"const fs=require('fs'),{execSync}=require('child_process');if(fs.existsSync('frontend')){execSync('npm --prefix frontend run build',{stdio:'inherit'});fs.cpSync('frontend/dist','dist',{recursive:true})}else{execSync('npm run build',{stdio:'inherit'})}\"",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
